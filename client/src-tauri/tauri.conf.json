{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "liaisonyy",
  "version": "0.4.1",
  "identifier": "cn.ycyz.liaisonyy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "liaisonyy",
        "width": 380,
        "height": 680,
        "minWidth": 260,
        "minHeight": 400,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}

